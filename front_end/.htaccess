# ==============================================================================
# LevelUp Study - Configuração Apache (.htaccess)
# Compatível com Apache 2.4+ / LiteSpeed / OpenLiteSpeed
# ==============================================================================

# ── 1. SEGURANÇA BÁSICA & LISTAGEM DE DIRETÓRIOS ─────────────────────────────
Options -Indexes +FollowSymLinks
DirectorySlash On

# ── 2. TIPOS MIME EXPLÍCITOS (Essencial para SVG, ICO e imagens não serem bloqueados) ──
<IfModule mod_mime.c>
    AddType image/svg+xml .svg .svgz
    AddType image/x-icon .ico
    AddType image/vnd.microsoft.icon .ico
    AddType image/png .png
    AddType image/webp .webp
    AddType text/css .css
    AddType application/javascript .js
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # ── 3. PASS-THROUGH TOTAL DE FAVICONS E RECURSOS ESTÁTICOS ─────────────────
    # Garante que requisições a favicons e pastas de assets nunca sofram rewrite
    RewriteRule ^(favicon\.ico|favicon\.svg|favicon-[0-9x]+\.png)$ - [L]
    RewriteRule ^(assets|css|js|images)/ - [L]

    # ── 4. BLOQUEIO DE ARQUIVOS OCULTOS E CÓDIGOS SENSÍVEIS ───────────────────
    RewriteRule ^\.(?!well-known/) - [F,L]
    RewriteRule \.(py|pyc|pyo|pyd|db|sqlite|sqlite3|sql|bak|log|conf|ini|sh|yaml|yml|md|env)$ - [F,L]
    RewriteRule ^(back_end|\.git|\.venv|venv|migrations|tests)/ - [F,L]

    # ── 5. REDIRECIONAMENTOS CANÔNICOS (Remove .html da barra de navegação) ────
    RewriteCond %{THE_REQUEST} \s/landing\.html[\s?] [NC]
    RewriteRule ^landing\.html$ / [R=301,L]

    RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
    RewriteRule ^index\.html$ /app [R=301,L]

    RewriteCond %{THE_REQUEST} \s/([^.]+)\.html[\s?] [NC]
    RewriteRule ^([^.]+)\.html$ /$1 [R=301,L]

    # ── 6. ROTEAMENTO AMIGÁVEL INTERNO (Serve o arquivo HTML correspondente) ──
    # Página inicial pública de vendas (Landing Page)
    RewriteRule ^$ landing.html [L]
    RewriteRule ^landing/?$ / [R=301,L]

    # Painel autenticado do aluno
    RewriteRule ^(app|dashboard)/?$ index.html [L]

    # Rotas específicas do frontend
    RewriteRule ^(login|register|checkout|admin|planos|assinatura)/?$ $1.html [L]

    # Fallback genérico para qualquer página .html existente
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^([a-zA-Z0-9_-]+)/?$ $1.html [L]
</IfModule>

# ── 7. HEADERS DE SEGURANÇA & SUPORTE A ÍCONES / CORS ────────────────────────
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Libera CORS para favicons, imagens e fontes
    <FilesMatch "\.(ico|svg|png|jpg|jpeg|webp|woff|woff2|ttf|eot)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>

# ── 8. CACHE DE FAVICONS E ASSETS ESTÁTICOS ──────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/vnd.microsoft.icon "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/png "access plus 7 days"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
</IfModule>
