# ==============================================================================
# LevelUp Study — Exemplo de Variáveis de Ambiente (.env.example)
# ==============================================================================
# Copie este arquivo para .env e preencha com suas configurações reais:
#   cp .env.example .env
#
# Em desenvolvimento local:
#   USE_SQLITE=true
#
# Em produção (HestiaCP / Servidor Linux):
#   USE_SQLITE=false e configure DATABASE_URL para o MySQL do HestiaCP
# ==============================================================================

# ── Configurações da Aplicação ────────────────────────────────────────────────
FLASK_APP=backend.py
ENVIRONMENT=development                # development | production
SECRET_KEY=substitua_por_chave_gerada_openssl_rand_hex_32
PORT=5000                              # Porta interna (5000 local, 8017 em prod com Gunicorn)

# ── URLs e Domínio ────────────────────────────────────────────────────────────
DOMAIN=levelupstudy.com.br
FRONTEND_URL=https://levelupstudy.com.br

# ── Banco de Dados (MySQL / MariaDB HestiaCP vs SQLite Local) ────────────────
# Defina USE_SQLITE=true para usar o SQLite local (levelupstudy.db) em desenvolvimento
# Defina USE_SQLITE=false para conectar ao MySQL do HestiaCP
USE_SQLITE=true

# Opção 1: String de conexão completa para produção (Recomendado para o HestiaCP)
DATABASE_URL=mysql+pymysql://levelup_user:senha_do_banco@127.0.0.1:3306/levelup_db?charset=utf8mb4

# Opção 2: Parâmetros individuais (usados como fallback se DATABASE_URL não estiver definida)
DB_USER=levelup_user
DB_PASS=senha_do_banco
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=levelup_db

# ── Inteligência Artificial (Google Gemini) ──────────────────────────────────
# Obtenha sua chave no Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=sua_chave_gemini_api_aqui

# ── Stripe (Pagamentos & Assinaturas de Concurseiros) ────────────────────────
# Chaves obtidas em https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_suaChaveSecretaStripeAqui
STRIPE_PUBLISHABLE_KEY=pk_test_suaChavePublicaStripeAqui

# Segredo de assinatura de Webhook do Stripe
STRIPE_WEBHOOK_SECRET=whsec_seuWebhookSecretAqui

# IDs dos Preços/Produtos criados no Stripe Dashboard
STRIPE_PRICE_MONTHLY=price_planoMensalIdAqui
STRIPE_PRICE_YEARLY=price_planoAnualIdAqui
