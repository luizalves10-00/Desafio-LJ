# ==============================================================================
# HestiaCP Nginx Template - HTTPS / SSL (levelup-study.stpl)
# Domain: levelupstudy.com.br
# DevSecOps Hardening: PCI-DSS, OWASP Top 10, Strict CSP, Anti-Scanning
# ==============================================================================

server {
    listen      %ip%:%web_ssl_port% ssl http2;
    server_name %domain_idn% %alias_idn%;
    root        %sdocroot%;
    index       index.html;

    # ── SSL Certificates & Modern Ciphers (TLS 1.2 & TLS 1.3 only) ───────────
    ssl_certificate         %ssl_pem%;
    ssl_certificate_key     %ssl_key%;
    ssl_protocols           TLSv1.2 TLSv1.3;
    ssl_ciphers             ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout     1d;
    ssl_session_cache       shared:SSL:10m;
    ssl_session_tickets     off;
    ssl_stapling            on;
    ssl_stapling_verify     on;

    # ── Security Headers (OWASP / PCI-DSS Recommendation) ─────────────────────
    # HSTS: Força HTTPS por 1 ano com subdomínios e inclusão na preload list
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

    # Previne Clickjacking (impedindo iframes não autorizados do nosso próprio site)
    add_header X-Frame-Options "DENY" always;

    # Previne ataques de MIME-type confusion / sniffing
    add_header X-Content-Type-Options "nosniff" always;

    # Filtro XSS legado para navegadores antigos
    add_header X-XSS-Protection "1; mode=block" always;

    # Controle de vazamento de referer
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Restrição de hardware do dispositivo
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(self 'https://js.stripe.com')" always;

    # Content Security Policy (CSP) restrito com exceções autorizadas para Stripe e Google OAuth
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://js.stripe.com https://accounts.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; connect-src 'self' https://api.stripe.com https://levelupstudy.com.br; frame-src https://js.stripe.com https://hooks.stripe.com https://accounts.google.com; object-src 'none'; base-uri 'self'; form-action 'self' https://accounts.google.com; upgrade-insecure-requests;" always;

    # Oculta versão do Nginx nos cabeçalhos
    server_tokens off;

    # ── Logs ──────────────────────────────────────────────────────────────────
    access_log  /var/log/nginx/domains/%domain%.log combined;
    error_log   /var/log/nginx/domains/%domain%.error.log error;

    # ── 1. BLOQUEIO DE ARQUIVOS OCULTOS, SENROC E VARREDURAS (DROP / 404) ─────
    # Bloqueia arquivos .env, .git, .svn, .htaccess, etc.
    location ~ /\.(?!well-known).* {
        access_log off;
        log_not_found off;
        return 404;
    }

    # Bloqueia código-fonte python, bancos de dados e arquivos de configuração/backup
    location ~* \.(py|pyc|pyo|pyd|db|sqlite|sqlite3|sql|bak|log|conf|ini|sh|yaml|yml|md|env)$ {
        access_log off;
        log_not_found off;
        return 404;
    }

    # Bloqueia probes comuns de bots e scanners maliciosos
    location ~* /(wp-admin|wp-login\.php|phpmyadmin|pma|adminer|\.aws|\.docker|actuator|eval-stdin) {
        access_log off;
        log_not_found off;
        return 404;
    }

    # ── 2. PROXY REVERSO PARA A API FLASK / GUNICORN ───────────────────────────
    # Direciona chamadas /api/ para o backend Gunicorn (127.0.0.1:5000)
    location /api/ {
        proxy_pass          http://127.0.0.1:5000;
        proxy_http_version  1.1;

        proxy_set_header    Host                $host;
        proxy_set_header    X-Real-IP           $remote_addr;
        proxy_set_header    X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header    X-Forwarded-Proto   $scheme;
        proxy_set_header    X-Forwarded-Host    $host;
        proxy_set_header    X-Forwarded-Port    $server_port;

        # Timeouts de proteção
        proxy_connect_timeout 15s;
        proxy_read_timeout    60s;
        proxy_send_timeout    60s;

        # Desativa buffers para webhooks se necessário
        proxy_buffering       on;
        proxy_buffer_size     8k;
        proxy_buffers         8 8k;

        client_max_body_size  5M;
    }

    # ── 3. ROTEAMENTO DE ARQUIVOS ESTÁTICOS DO FRONTEND ───────────────────────
    location / {
        try_files $uri $uri/ /index.html;

        # Cache control para assets estáticos
        location ~* \.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
            expires 7d;
            add_header Cache-Control "public, no-transform";
            add_header X-Content-Type-Options "nosniff" always;
        }
    }

    # ── Let's Encrypt ACME Challenge ──────────────────────────────────────────
    location ~ /\.well-known/acme-challenge/ {
        root %sdocroot%;
        allow all;
    }
}
