# ==============================================================================
# HestiaCP Nginx Custom Include - LevelUp Study (HTTP - Porta 80)
# Local no Servidor: /home/LevelUp/conf/web/levelupstudy.com.br/nginx.conf_api
# ==============================================================================

# Redireciona chamadas da API em HTTP diretamente para HTTPS seguro
# (Não duplicamos location / aqui para evitar conflito com o template padrão do HestiaCP)
location ^~ /api/ {
    return 301 https://$host$request_uri;
}
